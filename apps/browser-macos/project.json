{
  "name": "browser-macos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/browser-macos/Sources",
  "projectType": "application",
  "tags": ["scope:browser", "type:native-host"],
  "targets": {
    "storage-native": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf1.py native"
      }
    },
    "storage-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf1.py build"
      }
    },
    "storage-diagnostic-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf1.py diagnostic-build"
      }
    },
    "storage-models": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf1.py models"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/browser-macos/build"],
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py build"
      },
      "cache": false
    },
    "build-workspace-qualification": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py build --wsf6-qualification"
      }
    },
    "build-unsigned-release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py build --unsigned-release"
      }
    },
    "build-legacy-chrome-fixture": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py chrome"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py audit"
      }
    },
    "launch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py launch"
      }
    },
    "storage-f2-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf2.py build"
      }
    },
    "storage-f2-contracts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf2.py contracts"
      }
    },
    "storage-f2-native": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf2.py security-native"
      }
    },
    "storage-f2-webkit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/wsf2.py webkit-native"
      }
    },
    "reliability-contracts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node_modules/.bin/tsx --test apps/browser-macos/Chrome/tests/navigation.test.ts"
      }
    },
    "reliability-typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node_modules/.bin/tsc --noEmit -p apps/browser-macos/Chrome/tsconfig.json"
      }
    },
    "reliability-ui": {
      "dependsOn": ["build-legacy-chrome-fixture"],
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "../../../node_modules/.bin/playwright test",
        "cwd": "apps/browser-macos/Chrome"
      }
    },
    "qualification-tool-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go test -count=1 -v ./...",
        "cwd": "tools/vezham-qualify"
      }
    },
    "qualification-tool-vet": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go vet ./...",
        "cwd": "tools/vezham-qualify"
      }
    }
  }
}
