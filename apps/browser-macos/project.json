{
  "name": "browser-macos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/browser-macos/Sources",
  "projectType": "application",
  "tags": ["scope:browser", "type:native-host"],
  "targets": {
    "storage-native": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "python3 apps/browser-macos/Tools/wsf1.py native" }
    },
    "storage-build": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "python3 apps/browser-macos/Tools/wsf1.py build" }
    },
    "storage-diagnostic-build": {
      "executor": "nx:run-commands", "cache": false,
      "options": { "command": "python3 apps/browser-macos/Tools/wsf1.py diagnostic-build" }
    },
    "storage-models": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "python3 apps/browser-macos/Tools/wsf1.py models" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/browser-macos/build"],
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py build"
      },
      "cache": false
    },
    "audit": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py audit"
      }
    },
    "launch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 apps/browser-macos/Tools/native_host.py launch"
      }
    }
  }
}
