rget.group = command.target\n                    target.pinned = false\n                  }\n                  break\n                case 'tabSpace':\n                  if (target) {\n                    target.space = command.target\n                    target.group = undefined\n                  }\n                  break\n                case 'pin':\n                  if (target) target.pinned = !target.pinned\n                  break\n                case 'split':\n                  if (target && state.selected)\n                    state.split = [state.selected, target.id]\n                  break\n                case 'unsplit':\n                  state.split = []\n                  break\n                case 'appearance':\n                  state.appearance = command.value as Appearance\n                  break\n              }\n              state.revision++\n              return Promise.resolve({\n                id: command.id,\n                state: structuredClone(state)\n              })\n            }\n          }\n        }\n      }\n    })\n  }, recovery)\n  await page.goto('/')\n};"}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { expect, test } from '@playwright/test'\nimport type { Page } from '@playwright/test'\n\nimport type { Appearance, BrowserState, Command, Tab } from '../src/bridge'\n\nasync function hostStandIn(page: Page, recovery?: BrowserState['recovery']) {\n  await page.addInitScript(initialRecovery => {\n    const state: BrowserState = {\n      revision: 0,\n      session: 'inactive',\n      recovery: initialRecovery,\n      profile: 'unavailable',\n      tabs: [],\n      appearance: 'system',\n      spaces: [{ id: 'personal', name: 'Personal' }],\n      activeSpace: 'personal',\n      groups: [],\n      split: [],\n      splitCompact: false,\n      mini: false,\n      workspaces: [{ id: 'workspace-one', name: 'Personal', empty: true }],