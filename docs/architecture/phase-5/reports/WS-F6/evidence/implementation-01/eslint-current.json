ine":1432,"endColumn":15},{"ruleId":"jsx-a11y/no-noninteractive-tabindex","severity":2,"message":"`tabIndex` should only be declared on interactive elements.","line":1409,"column":15,"nodeType":"JSXAttribute","endLine":1409,"endColumn":27},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":2042,"column":17,"nodeType":"JSXAttribute","endLine":2042,"endColumn":26}],"suppressedMessages":[],"errorCount":24,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Button, Input } from '@heroui/react'\nimport {\n  useCallback,\n  useEffect,\n  useLayoutEffect,\n  useRef,\n  useState\n} from 'react'\nimport type { FormEvent, KeyboardEvent, ReactNode } from 'react'\n\nimport { dispatch, initialState } from './bridge'\nimport type { Appearance, Command, MiniPreview, Result, Tab } from './bridge'\nimport { Icon } from './icons'\nimport { destination, search } from './navigation'\n\nconst sections = [\n  'Tabs',\n  'Bookmarks',\n  'History',\n  'Downloads',\n  'Profiles',\n  'Settings'\n] as const\ntype Section = (typeof sections)[number]\ntype Bookmark = { id: string; name: string; url: string; folder: string }\nconst settingSections = [\n  'General',\n  'Appearance',\n  'Tabs',\n  'Search',\n  'Privacy',\n  'Website permissions',\n  'Downloads',\n  'Profiles',\n  'Keyboard shortcuts',\n  'Advanced'\n] as const\nconst shortcutList = [\n  ['Focus address', '⌘L'],\n  ['New tab', '⌘T'],\n  ['Close tab', '⌘W'],\n  ['Reload', '⌘R'],\n  ['Commands', '⌘K'],\n  ['Settings', '⌘,']\n]\nconst errors = {\n  busy: 'Another browser action is in progress.',\n  unavailable: 'This action is unavailable for the current tab or session.',\n  invalid: 'This address or action is unsupported.',\n  failed: 'The browser could not complete that action.',\n  transferUnconfirmed:\n    'The destination did not confirm this page. Mini is still open.',\n  disconnected: 'The native browser host is unavailable.'\n}\n\nfunction Tool({\n  icon,\n  label,\n  action,\n  disabled = false\n}: {\n  icon: string\n  label: string\n  action: () => void\n  disabled?: boolean\n}) {\n  return (\n    <Button\n      isIconOnly\n      size=\"sm\"\n      variant=\"ghost\"\n      className=\"tool\"\n      aria-label={label}\n      isDisabled={disabled}\n      onPress={action}>\n      <Icon name={icon} />\n    </Button>\n  )\n}\n\nfunction Empty({\n  icon,\n  title,\n  children\n}: {\n  icon: string\n  title: string\n  children: ReactNode\n}) {\n  return (\n    <div className=\"empty\">\n      <span className=\"tile\">\n        <Icon name={icon} size={23} />\n      </span>\n      <h2>{title}</h2>\n      <p>{children}</p>\n    </div>\n  )\n}\n\nexport function Browser() {\n  const [browser, setBrowser] = useState(initialState)\n  const [connected, setConnected] = useState(false)\n  const [section, setSection] = useState<Section>('Tabs')\n  const [settings, setSettings] =\n    useState<(typeof settingSections)[number]>('Appearance')\n  const [sidebar, setSidebar] = useState(true)\n  const [sideWidth, setSideWidth] = useState(236)\n  const [editor, setEditor] = useState<{\n    type:\n      | 'spaceCreate'\n      | 'spaceRename'\n      | 'groupCreate'\n      | 'groupRename'\n      | 'workspaceCreate'\n      | 'workspaceRename'\n    target?: string\n    name: string\n  }>()\n  const [tabFilter, setTabFilter] = useState('')\n  const [draft, setDraft] = useState('')\n  const [editing, setEditing] = useState(false)\n  const [notice, setNotice] = useState('')\n  const [miniPreview, setMiniPreview] = useState<MiniPreview>()\n  const [transferring, setTransferring] = useState(false)\n  const [palette, setPalette] = useState(false)\n  const [query, setQuery] = useState('')\n  const [menu, setMenu] = useState<string>()\n  const [bookmarks, setBookmarks] = useState<Bookmark[]>([])\n  const [bookmarkQuery, setBookmarkQuery] = useState('')\n  const [bookmarkForm, setBookmarkForm] = useState<Bookmark>()\n  const address = useRef<HTMLInputElement>(null)\n  const commands = useRef<HTMLInputElement>(null)\n  const paletteDialog = useRef<HTMLDialogElement>(null)\n  const editorDialog = useRef<HTMLDialogElement>(null)\n  const contextDialog = useRef<HTMLDialogElement>(null)\n  const editorTrigger = useRef<HTMLElement | null>(null)\n  const skipFocusRestore = useRef(false)\n  const content = useRef<HTMLElement>(null)\n  const dragged = useRef<string>(undefined)\n  const active = browser.tabs.find(tab => tab.id === browser.selected)\n  const inPrivate = browser.session === 'private'\n  const theme = browser.appearance\n  const spaceTabs = browser.tabs.filter(\n    tab => tab.space === browser.activeSpace\n  )\n  const spaceGroups = browser.groups.filter(\n    group => group.space === browser.activeSpace\n  )\n  const currentSpace = browser.spaces.find(\n    space => space.id === browser.activeSpace\n  )\n  const splitTabs = browser.split\n    .map(id => browser.tabs.find(tab => tab.id === id))\n    .filter((tab): tab is Tab => Boolean(tab))\n  const workspaces = browser.workspaces ?? []\n  const currentWorkspace = workspaces.find(\n    workspace => workspace.id === browser.activeWorkspace\n  )\n  const visibleTabs =\n    splitTabs.length === 2 && !browser.splitCompact\n      ? splitTabs\n      : active\n        ? [active]\n        : []\n  const isWeb =\n    !browser.recovery &&\n    section === 'Tabs' &&\n    visibleTabs.some(tab => tab.url && !tab.failure) &&\n    !palette &&\n    !menu &&\n    !editing &&\n    !editor &&\n    !miniPreview\n  const renderedTabs = [\n    ...spaceTabs.filter(tab => tab.pinned),\n    ...spaceGroups\n      .filter(group => !group.collapsed)\n      .flatMap(group =>\n        spaceTabs.filter(tab => !tab.pinned && tab.group === group.id)\n      ),\n    ...spaceTabs.filter(tab => !tab.pinned && !tab.group)\n  ].filter(\n    tab =>\n      !tabFilter || tab.title.toLowerCase().includes(tabFilter.toLowerCase())\n  )\n  const keyboardTab =\n    renderedTabs.find(tab => tab.id === browser.selected) ?? renderedTabs[0]\n  const canSplit = !browser.mini && spaceTabs.some(tab => tab.id !== active?.id)\n\n  const accept = useCallback((response: Result) => {\n    if (response.error === 'disconnected') {\n      setConnected(false)\n      return\n    }\n    setConnected(true)\n    setBrowser(state =>\n      response.state.revision > state.revision ? response.state : state\n    )\n  }, [])\n  const send = useCallback(\n    async (command: Command) => {\n      const response = await dispatch(command)\n      accept(response)\n      if (response.error) setNotice(errors[response.error])\n      else if (command.type !== 'snapshot') setNotice('')\n      return response\n    },\n    [accept]\n  )\n\n  useEffect(() => {\n    let mounted = true\n    let pending = false\n    const update = async () => {\n      if (pending) return\n      pending = true\n      const result = await dispatch({ type: 'snapshot' })\n      pending = false\n      if (mounted) accept(result)\n    }\n    void update()\n    const timer = setInterval(update, 240)\n    return () => {\n      mounted = false\n      clearInterval(timer)\n    }\n  }, [accept])\n\n  useEffect(() => {\n    setEditing(false)\n    setMiniPreview(undefined)\n    setSection('Tabs')\n  }, [browser.selected, browser.activeWorkspace])\n\n  useEffect(() => {\n    document.documentElement.dataset.theme = theme\n  }, [theme])\n\n  useEffect(() => {\n    if (!browser.recovery) return\n    setPalette(false)\n    setMenu(undefined)\n    setEditor(undefined)\n    setEditing(false)\n    setDraft('')\n  }, [browser.recovery])\n\n  useLayoutEffect(() => {\n    setBookmarks([])\n    setBookmarkForm(undefined)\n    setBookmarkQuery('')\n  }, [browser.sessionID])\n\n  useEffect(() => {\n    const surface = content.current\n    if (!surface || !connected) return\n    const present = () => {\n      const rect = surface.getBoundingClientRect()\n      void dispatch({\n        type: 'presentation',\n        visible: isWeb,\n        left: rect.left,\n        top: rect.top\n      })\n    }\n    const observer = new ResizeObserver(present)\n    observer.observe(surface)\n    window.addEventListener('resize', present)\n    present()\n    return () => {\n      observer.disconnect()\n      window.removeEventListener('resize', present)\n    }\n  }, [\n    connected,\n    isWeb,\n    sidebar,\n    sideWidth,\n    section,\n    browser.split.length,\n    browser.mini\n  ])\n\n  useEffect(() => {\n    const dialog = palette\n      ? paletteDialog.current\n      : editor\n        ? editorDialog.current\n        : menu\n          ? contextDialog.current\n          : null\n    if (!dialog) return\n    const previous = editor\n      ? editorTrigger.current\n      : document.activeElement instanceof HTMLElement\n        ? document.activeElement\n        : null\n    if (!dialog.open) dialog.showModal()\n    dialog.querySelector<HTMLElement>('input, button:not([disabled])')?.focus()\n    return () => {\n      dialog.close()\n      if (skipFocusRestore.current) {\n        skipFocusRestore.current = false\n        return\n      }\n      requestAnimationFrame(() => {\n        if (previous?.isConnected) previous.focus()\n        else\n          document\n            .querySelector<HTMLElement>(\n              '[aria-label=\"Workspace actions\"], [aria-label=\"Address and search\"]'\n            )\n            ?.focus()\n      })\n    }\n  }, [palette, Boolean(editor), menu])\n\n  function openEditor(value: NonNullable<typeof editor>) {\n    editorTrigger.current =\n      document.activeElement instanceof HTMLElement\n        ? document.activeElement\n        : null\n    setEditor(value)\n  }\n  function containModalFocus(event: KeyboardEvent<HTMLDialogElement>) {\n    if (event.key !== 'Tab') return\n    const items = Array.from(\n      event.currentTarget.querySelectorAll<HTMLElement>(\n        'input, button:not([disabled])'\n      )\n    )\n    const edge = event.shiftKey ? items[0] : items.at(-1)\n    if (items.length && document.activeElement === edge) {\n      event.preventDefault()\n      ;(event.shiftKey ? items.at(-1) : items[0])?.focus()\n    }\n  }\n  function choose(value: Section) {\n    setSection(value)\n    setMenu(undefined)\n  }\n  function focusAddress() {\n    if (palette || menu || editor) skipFocusRestore.current = true\n    choose('Tabs')\n    setDraft(active?.url ?? '')\n    setEditing(true)\n    requestAnimationFrame(() => {\n      address.current?.focus()\n      address.current?.select()\n    })\n  }\n  function openPalette() {\n    setQuery('')\n    setMenu(undefined)\n    setPalette(true)\n  }\n  function closePalette() {\n    setPalette(false)\n  }\n  function tabAction(\n    type:\n      | 'close'\n      | 'duplicate'\n      | 'back'\n      | 'forward'\n      | 'reload'\n      | 'stop'\n      | 'copy'\n      | 'paste',\n    tab = active\n  ) {\n    if (!tab) return\n    void send({ type, tab: tab.id }).then(response => {\n      if (type === 'copy' && !response.error) setNotice('Address copied.')\n      if (type === 'paste' && response.text) void openAddress(response.text)\n    })\n    setMenu(undefined)\n  }\n  async function createTab() {\n    const result = await send({ type: inPrivate ? 'newTab' : 'startPrivate' })\n    if (!result.error) {\n      choose('Tabs')\n      setEditing(false)\n    }\n  }\n  function selectTab(tab: Tab) {\n    choose('Tabs')\n    setEditing(false)\n    void send({ type: 'activate', tab: tab.id })\n  }\n  async function openAddress(value: string) {\n    const url = destination(value)\n    if (!url) {\n      setNotice('Enter a valid web address or search query.')\n      return\n    }\n    const target =\n      active ??\n      (inPrivate\n        ? await send({ type: 'newTab' }).then(({ state }) =>\n            state.tabs.find(tab => tab.id === state.selected)\n          )\n        : undefined)\n    if (!target) {\n      setNotice('Start a private session to browse.')\n      return\n    }\n    choose('Tabs')\n    setEditing(false)\n    address.current?.blur()\n    await send({ type: 'navigate', url, tab: target.id })\n  }\n  function handleAddress(event: FormEvent) {\n    event.preventDefault()\n    void openAddress(draft)\n  }\n  function keyAction(key: string) {\n    switch (key) {\n      case 'l':\n        focusAddress()\n        break\n      case 't':\n        openPalette()\n        break\n      case 'w':\n        tabAction('close')\n        break\n      case 'r':\n        tabAction('reload')\n        break\n      case 'k':\n        openPalette()\n        break\n      case ',':\n        choose('Settings')\n        break\n      case '[':\n        tabAction('back')\n        break\n      case ']':\n        tabAction('forward')\n        break\n    }\n  }\n  useEffect(() => {\n    const shortcut = (event: globalThis.KeyboardEvent) => {\n      if (\n        !event.metaKey ||\n        event.altKey ||\n        event.ctrlKey ||\n        !['l', 't', 'w', 'r', 'k', ',', '[', ']'].includes(\n          event.key.toLowerCase()\n        )\n      )\n        return\n      event.preventDefault()\n      keyAction(event.key.toLowerCase())\n    }\n    const fromHost = (event: Event) =>\n      keyAction((event as CustomEvent<string>).detail)\n    window.addEventListener('keydown', shortcut)\n    window.addEventListener('vezham-shortcut', fromHost)\n    return () => {\n      window.removeEventListener('keydown', shortcut)\n      window.removeEventListener('vezham-shortcut', fromHost)\n    }\n  })\n\n  const paletteActions = [\n    {\n      name: inPrivate ? 'New tab' : 'Start private session',\n      key: '⌘T',\n      run: createTab\n    },\n    { name: 'Focus address', key: '⌘L', run: focusAddress, disabled: !active },\n    {\n      name: 'Reload tab',\n      key: '⌘R',\n      run: () => tabAction('reload'),\n      disabled: !active?.url\n    },\n    {\n      name: 'Create workspace',\n      key: '',\n      run: () => openEditor({ type: 'workspaceCreate', name: '' }),\n      disabled: !inPrivate\n    },\n    {\n      name: 'Rename workspace',\n      key: '',\n      run: () =>\n        currentWorkspace &&\n        openEditor({\n          type: 'workspaceRename',\n          target: currentWorkspace.id,\n          name: currentWorkspace.name\n        }),\n      disabled: !currentWorkspace || !inPrivate\n    },\n    {\n      name: 'Move workspace earlier',\n      key: '',\n      run: () =>\n        currentWorkspace &&\n        void send({\n          type: 'workspaceMove',\n          target: currentWorkspace.id,\n          offset: -1\n        }),\n      disabled: !currentWorkspace || !inPrivate\n    },\n    {\n      name: 'Move workspace later',\n      key: '',\n      run: () =>\n        currentWorkspace &&\n        void send({\n          type: 'workspaceMove',\n          target: currentWorkspace.id,\n          offset: 1\n        }),\n      disabled: !currentWorkspace || !inPrivate\n    },\n    ...workspaces.map(workspace => ({\n      id: 'workspace:' + workspace.id,\n      name: 'Workspace · ' + workspace.name,\n      key: '',\n      run: () => void send({ type: 'workspaceSwitch', target: workspace.id }),\n      disabled: !inPrivate\n    })),\n    ...workspaces\n      .filter(\n        workspace => workspace.empty && workspace.id !== currentWorkspace?.id\n      )\n      .map(workspace => ({\n        id: 'delete-workspace:' + workspace.id,\n        name: 'Delete empty workspace · ' + workspace.name,\n        key: '',\n        run: () => void send({ type: 'workspaceDelete', target: workspace.id }),\n        disabled: !inPrivate\n      })),\n    {\n      name: 'Create Space',\n      key: '',\n      run: () => openEditor({ type: 'spaceCreate', name: '' }),\n      disabled: !inPrivate\n    },\n    {\n      name: 'Create tab group',\n      key: '',\n      run: () => openEditor({ type: 'groupCreate', name: '' }),\n      disabled: !inPrivate\n    },\n    {\n      name: 'Add Split Screen',\n      key: '',\n      run: () => {\n        const other = spaceTabs.find(tab => tab.id !== active?.id)\n        if (other) void send({ type: 'split', tab: other.id })\n      },\n      disabled: !canSplit\n    },\n    {\n      name: 'Exit Split Screen',\n      key: '',\n      run: () => void send({ type: 'unsplit' }),\n      disabled: !browser.split.length\n    },\n    {\n      name: 'Open in Vezham Mini',\n      key: '',\n      run: () => active && void send({ type: 'miniOpen', tab: active.id }),\n      disabled: !active?.url || browser.mini\n    },\n    {\n      name: 'Close active tab',\n      key: '⌘W',\n      run: () => tabAction('close'),\n      disabled: !active\n    },\n    ...browser.tabs.map(tab => ({\n      id: 'tab:' + tab.id,\n      name: 'Tab · ' + tab.title,\n      key: '',\n      run: () => selectTab(tab)\n    })),\n    ...browser.spaces.map(space => ({\n      id: 'space:' + space.id,\n      name: 'Space · ' + space.name,\n      key: '',\n      run: () => {\n        choose('Tabs')\n        void send({ type: 'spaceSwitch', target: space.id })\n      }\n    })),\n    ...(query.trim() && inPrivate\n      ? [\n          {\n            name: 'Go to · ' + query.trim(),\n            key: '↵',\n            run: async () => {\n              let target = active\n              if (!target) {\n                const result = await send({ type: 'newTab' })\n                target = result.state.tabs.find(\n                  tab => tab.id === result.state.selected\n                )\n              }\n              const url = destination(query)\n              if (target && url) {\n                choose('Tabs')\n                void send({ type: 'navigate', tab: target.id, url })\n              }\n            }\n          }\n        ]\n      : []),\n    { name: 'Toggle sidebar', key: '', run: () => setSidebar(value => !value) },\n    ...sections\n      .slice(1)\n      .map(name => ({\n        name: 'Open ' + name.toLowerCase(),\n        key: name === 'Settings' ? '⌘,' : '',\n        run: () => choose(name)\n      }))\n  ].filter(item => item.name.toLowerCase().includes(query.toLowerCase()))\n\n  function paletteKey(event: KeyboardEvent<HTMLDialogElement>) {\n    if (event.key === 'Escape') {\n      event.preventDefault()\n      closePalette()\n    }\n    const items = Array.from(\n      event.currentTarget.querySelectorAll<HTMLElement>(\n        'input, button:not([disabled])'\n      )\n    )\n    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {\n      event.preventDefault()\n      const index = items.indexOf(document.activeElement as HTMLElement)\n      items[\n        (index + (event.key === 'ArrowDown' ? 1 : items.length - 1)) %\n          items.length\n      ]?.focus()\n    } else if (event.key === 'Tab' && items.length) {\n      const edge = event.shiftKey ? items[0] : items.at(-1)\n      if (document.activeElement === edge) {\n        event.preventDefault()\n        ;(event.shiftKey ? items.at(-1) : items[0])?.focus()\n      }\n    }\n  }\n\n  function addBookmark(event: FormEvent) {\n    event.preventDefault()\n    if (!inPrivate || !bookmarkForm) return\n    const url = destination(bookmarkForm.url)\n    if (!url || !bookmarkForm.name.trim()) {\n      setNotice('Enter a name and a valid destination.')\n      return\n    }\n    setBookmarks(items =>\n      items.some(item => item.id === bookmarkForm.id)\n        ? items.map(item =>\n            item.id === bookmarkForm.id ? { ...bookmarkForm, url } : item\n          )\n        : [...items, { ...bookmarkForm, url }]\n    )\n    setBookmarkForm(undefined)\n    setNotice('')\n  }\n\n  function moveBookmark(id: string, offset: number) {\n    setBookmarks(items => {\n      const index = items.findIndex(item => item.id === id)\n      const next = index + offset\n      if (index < 0 || next < 0 || next >= items.length) return items\n      const moved = items.slice()\n      ;[moved[index], moved[next]] = [moved[next], moved[index]]\n      return moved\n    })\n  }\n\n  function tabMenu(tab: Tab) {\n    return (\n      <div className=\"popover\" aria-label=\"Tab actions\">\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          onPress={() => {\n            void send({ type: 'pin', tab: tab.id })\n            setMenu(undefined)\n          }}>\n          {tab.pinned ? 'Unpin tab' : 'Pin tab'}\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          isDisabled={!active || active.id === tab.id}\n          onPress={() => {\n            void send({ type: 'split', tab: tab.id })\n            setMenu(undefined)\n          }}>\n          Open in split\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          isDisabled={!tab.url}\n          onPress={() => {\n            void send({ type: 'miniOpen', tab: tab.id })\n            setMenu(undefined)\n          }}>\n          Open in Vezham Mini\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          isDisabled={!tab.url}\n          onPress={() => tabAction('reload', tab)}>\n          Reload\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          onPress={() => tabAction('duplicate', tab)}>\n          Duplicate tab\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          onPress={() => {\n            void send({ type: 'move', tab: tab.id, offset: -1 })\n            setMenu(undefined)\n          }}>\n          Move up\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          onPress={() => {\n            void send({ type: 'move', tab: tab.id, offset: 1 })\n            setMenu(undefined)\n          }}>\n          Move down\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          isDisabled={!tab.url}\n          onPress={() => tabAction('copy', tab)}>\n          Copy address\n        </Button>\n        {spaceGroups.map(group => (\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            key={group.id}\n            onPress={() => {\n              void send({ type: 'tabGroup', tab: tab.id, target: group.id })\n              setMenu(undefined)\n            }}>\n            Move to {group.name}\n          </Button>\n        ))}\n        {tab.group && (\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            onPress={() => {\n              void send({ type: 'tabGroup', tab: tab.id })\n              setMenu(undefined)\n            }}>\n            Remove from group\n          </Button>\n        )}\n        {browser.spaces\n          .filter(space => space.id !== tab.space)\n          .map(space => (\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              key={space.id}\n              onPress={() => {\n                void send({ type: 'tabSpace', tab: tab.id, target: space.id })\n                setMenu(undefined)\n              }}>\n              Move to {space.name}\n            </Button>\n          ))}\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          onPress={() => tabAction('close', tab)}>\n          Close tab\n        </Button>\n      </div>\n    )\n  }\n\n  function verticalTab(tab: Tab) {\n    if (tabFilter && !tab.title.toLowerCase().includes(tabFilter.toLowerCase()))\n      return null\n    return (\n      <div\n        key={tab.id}\n        className={\n          tab.id === browser.selected ? 'vertical-tab current' : 'vertical-tab'\n        }\n        onContextMenu={event => {\n          event.preventDefault()\n          setMenu(tab.id)\n        }}\n        onDragOver={event => {\n          event.preventDefault()\n          event.dataTransfer.dropEffect = 'move'\n        }}\n        onDrop={event => {\n          event.preventDefault()\n          const from = browser.tabs.findIndex(\n            item => item.id === dragged.current\n          )\n          if (from >= 0 && browser.tabs[from].id !== tab.id) {\n            void send({\n              type: 'move',\n              tab: browser.tabs[from].id,\n              offset: browser.tabs.indexOf(tab) - from\n            })\n          }\n          dragged.current = undefined\n        }}>\n        <button\n          className=\"tab\"\n          role=\"tab\"\n          aria-selected={tab.id === browser.selected}\n          tabIndex={tab.id === keyboardTab?.id ? 0 : -1}\n          draggable\n          onDragStart={event => {\n            dragged.current = tab.id\n            event.dataTransfer.effectAllowed = 'move'\n            event.dataTransfer.setData('application/x-vezham-tab', tab.id)\n          }}\n          onDragEnd={() => {\n            dragged.current = undefined\n          }}\n          onKeyDown={event => {\n            if (\n              event.key === 'ContextMenu' ||\n              (event.shiftKey && event.key === 'F10')\n            ) {\n              event.preventDefault()\n              setMenu(tab.id)\n            }\n            if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {\n              const rendered = Array.from(\n                event.currentTarget\n                  .closest('[role=\"tablist\"]')\n                  ?.querySelectorAll<HTMLButtonElement>('[role=\"tab\"]') ?? []\n              )\n              const next =\n                rendered[\n                  (rendered.indexOf(event.currentTarget) +\n                    (event.key === 'ArrowUp' ? rendered.length - 1 : 1)) %\n                    rendered.length\n                ]\n              if (next) {\n                event.preventDefault()\n                next.focus()\n                next.click()\n              }\n            }\n          }}\n          onClick={() => selectTab(tab)}>\n          {tab.loading ? (\n            <span className=\"spinner\" aria-label=\"Loading\" />\n          ) : tab.favicon ? (\n            <img className=\"favicon\" src={tab.favicon} alt=\"\" />\n          ) : (\n            <Icon\n              name={\n                tab.failure\n                  ? 'info'\n                  : tab.pinned\n                    ? 'pin'\n                    : tab.url\n                      ? 'globe'\n                      : 'logo'\n              }\n              size={16}\n            />\n          )}\n          <span>{tab.title || 'New tab'}</span>\n        </button>\n        <Tool\n          icon=\"menu\"\n          label={'Actions for ' + tab.title}\n          action={() => setMenu(menu === tab.id ? undefined : tab.id)}\n        />\n        <Tool\n          icon=\"close\"\n          label={'Close ' + tab.title}\n          action={() => tabAction('close', tab)}\n        />\n      </div>\n    )\n  }\n\n  function miniView() {\n    return (\n      <div className=\"mini-browser\">\n        <header className=\"mini-toolbar\">\n          <span className=\"mini-brand\">\n            <Icon name=\"logo\" size={18} />\n            <strong>Mini</strong>\n          </span>\n          <Tool\n            icon=\"back\"\n            label=\"Go back\"\n            disabled={!active?.back}\n            action={() => tabAction('back')}\n          />\n          <Tool\n            icon=\"forward\"\n            label=\"Go forward\"\n            disabled={!active?.forward}\n            action={() => tabAction('forward')}\n          />\n          <Tool\n            icon={active?.loading ? 'stop' : 'reload'}\n            label={active?.loading ? 'Stop loading' : 'Reload'}\n            disabled={!active?.url}\n            action={() => tabAction(active?.loading ? 'stop' : 'reload')}\n          />\n          <form className=\"mini-address\" onSubmit={handleAddress}>\n            <Input\n              aria-label=\"Mini address\"\n              value={editing ? draft : (active?.url ?? '')}\n              onFocus={() => {\n                setDraft(active?.url ?? '')\n                setEditing(true)\n              }}\n              onBlur={() => setEditing(false)}\n              onChange={event => setDraft(event.target.value)}\n            />\n          </form>\n        </header>\n        <div className=\"mini-actions\">\n          <span>\n            <Icon name=\"shield\" size={13} /> Private · separate session\n          </span>\n          <Button\n            size=\"sm\"\n            variant=\"ghost\"\n            onPress={() =>\n              void send({ type: 'miniTransferPreview' }).then(response =>\n                setMiniPreview(response.miniPreview)\n              )\n            }\n            isDisabled={!browser.miniEligible || transferring}>\n            Open in workspace <Icon name=\"arrow\" size={14} />\n          </Button>\n        </div>\n        {miniPreview && (\n          <section\n            className=\"mini-actions\"\n            aria-label=\"Confirm workspace destination\">\n            <span className=\"truncate\" title={miniPreview.url}>\n              {miniPreview.url} → {miniPreview.workspace} / {miniPreview.space}{' '}\n              · Private\n            </span>\n            <Button\n              size=\"sm\"\n              onPress={async () => {\n                const token = miniPreview.token\n                setMiniPreview(undefined)\n                setTransferring(true)\n                try {\n                  await send({ type: 'miniTransfer', target: token })\n                } finally {\n                  setTransferring(false)\n                }\n              }}>\n              Open link\n            </Button>\n            <Button\n              size=\"sm\"\n              variant=\"ghost\"\n              onPress={() => setMiniPreview(undefined)}>\n              Cancel\n            </Button>\n          </section>\n        )}\n        <main ref={content} className=\"mini-content\" aria-label=\"Mini page\">\n          {active?.failure && (\n            <Empty icon=\"globe\" title=\"This page couldn’t load\">\n              Enter another address or reload.\n            </Empty>\n          )}\n        </main>\n        <footer className=\"status\">\n          <span>\n            {notice ||\n              (transferring\n                ? 'Waiting for the workspace page…'\n                : active?.loading\n                  ? 'Loading…'\n                  : active?.title || 'Vezham Mini')}\n          </span>\n          <span>Private</span>\n        </footer>\n      </div>\n    )\n  }\n\n  if (browser.recovery) {\n    const ready = browser.recovery === 'ready'\n    const failed = browser.recovery === 'failed'\n    const title = failed\n      ? 'Private workspace unavailable'\n      : 'Web content stopped'\n    const description = ready\n      ? 'Restore your workspace layout in a fresh private session. Pages will start blank.'\n      : failed\n        ? 'The browser could not safely finish recovery. Close this window to continue.'\n        : browser.recovery === 'rebuilding'\n          ? 'Opening a fresh private session…'\n          : 'Closing the stopped private session…'\n    return (\n      <main className=\"content\" aria-label=\"Private workspace recovery\">\n        <div className=\"panel\">\n          <div role=\"status\">\n            <Empty icon=\"globe\" title={title}>\n              {description}\n            </Empty>\n          </div>\n          {ready && (\n            <Button\n              variant=\"primary\"\n              onPress={() => void send({ type: 'recoverPrivate' })}>\n              Restore private workspace\n            </Button>\n          )}\n        </div>\n      </main>\n    )\n  }\n\n  if (browser.mini) return miniView()\n\n  return (\n    <div\n      className=\"browser arc-workspace\"\n      style={\n        {\n          '--sidebar-width': sidebar ? sideWidth + 'px' : '0px'\n        } as React.CSSProperties\n      }\n      onKeyDown={event => {\n        if (event.key === 'Escape') {\n          if (editor) setEditor(undefined)\n          else if (menu) setMenu(undefined)\n        }\n      }}>\n      <header className=\"chrome\">\n        <div className=\"browser-toolbar\">\n          <Tool\n            icon=\"sidebar\"\n            label={sidebar ? 'Hide sidebar' : 'Show sidebar'}\n            action={() => setSidebar(!sidebar)}\n          />\n          <span className=\"divider\" />\n          <Tool\n            icon=\"back\"\n            label=\"Go back\"\n            action={() => tabAction('back')}\n            disabled={!active?.back}\n          />\n          <Tool\n            icon=\"forward\"\n            label=\"Go forward\"\n            action={() => tabAction('forward')}\n            disabled={!active?.forward}\n          />\n          <Tool\n            icon={active?.loading ? 'stop' : 'reload'}\n            label={active?.loading ? 'Stop loading' : 'Reload'}\n            action={() => tabAction(active?.loading ? 'stop' : 'reload')}\n            disabled={!active?.url}\n          />\n          <div className=\"omnibox\">\n            <form onSubmit={handleAddress} className=\"address\">\n              <span\n                title={\n                  active?.connection === 'encrypted'\n                    ? 'WebKit reports an encrypted connection'\n                    : active?.connection === 'unencrypted'\n                      ? 'Unencrypted connection'\n                      : 'Connection information unavailable'\n                }>\n                <Icon\n                  name={\n                    active?.connection === 'encrypted'\n                      ? 'lock'\n                      : active?.connection === 'unencrypted'\n                        ? 'info'\n                        : 'search'\n                  }\n                  size={15}\n                />\n              </span>\n              <Input\n                ref={address}\n                aria-label=\"Address and search\"\n                placeholder={\n                  inPrivate\n                    ? 'Search or enter an address'\n                    : 'Start a private session to browse'\n                }\n                value={editing ? draft : (active?.url ?? '')}\n                disabled={!active}\n                onChange={event => setDraft(event.target.value)}\n                onFocus={() => {\n                  setDraft(active?.url ?? '')\n                  setEditing(true)\n                }}\n                onBlur={() => {\n                  setEditing(false)\n                }}\n                onKeyDown={event => {\n                  if (event.key === 'Escape') {\n                    setEditing(false)\n                    address.current?.blur()\n                  }\n                }}\n              />\n              <kbd>⌘L</kbd>\n            </form>\n            {editing && draft && (\n              <div className=\"suggestions\">\n                {search.suggestions(draft).map(item => (\n                  <Button\n                    key={item.label}\n                    variant=\"ghost\"\n                    onPress={() => void openAddress(item.value)}\n                    onPointerDown={event => event.preventDefault()}>\n                    <Icon name=\"search\" size={15} />\n                    {item.label}\n                    <span className=\"truncate\">{item.value}</span>\n                  </Button>\n                ))}\n              </div>\n            )}\n          </div>\n          <Tool\n            icon=\"split\"\n            label={browser.split.length ? 'Exit split' : 'Add split'}\n            disabled={!canSplit && !browser.split.length}\n            action={() => {\n              if (browser.split.length) void send({ type: 'unsplit' })\n              else {\n                const other = spaceTabs.find(tab => tab.id !== active?.id)\n                if (other) void send({ type: 'split', tab: other.id })\n              }\n            }}\n          />\n          <Tool\n            icon=\"command\"\n            label=\"Open command palette\"\n            action={openPalette}\n          />\n          <div className=\"nav-menu\">\n            <Tool\n              icon=\"menu\"\n              label=\"Navigation actions\"\n              action={() =>\n                setMenu(menu === 'navigation' ? undefined : 'navigation')\n              }\n            />\n          </div>\n          <span className={inPrivate ? 'session-tag private' : 'session-tag'}>\n            <span className=\"session-dot\" />\n            {inPrivate\n              ? (currentWorkspace?.name ?? 'Private session')\n              : 'Workspace'}\n          </span>\n        </div>\n\n        {active?.loading && (\n          <div\n            className=\"progress\"\n            role=\"progressbar\"\n            aria-label=\"Page loading\"\n            aria-valuenow={Math.round(active.progress * 100)}>\n            <span style={{ width: active.progress * 100 + '%' }} />\n          </div>\n        )}\n      </header>\n      <div className=\"workspace\">\n        {sidebar && (\n          <aside className=\"sidebar\" aria-label=\"Workspace sidebar\">\n            <div className=\"wordmark\">\n              <span className=\"brandmark\">\n                <Icon name=\"logo\" size={20} />\n              </span>\n              <strong>Vezham</strong>\n              <Tool\n                icon=\"menu\"\n                label=\"Workspace actions\"\n                action={() =>\n                  setMenu(menu === 'workspace' ? undefined : 'workspace')\n                }\n              />\n            </div>\n            <div className=\"spaces\" aria-label=\"Spaces\">\n              {browser.spaces.map((space, index) => (\n                <button\n                  key={space.id}\n                  aria-label={'Switch to ' + space.name}\n                  aria-pressed={space.id === browser.activeSpace}\n                  onDragOver={event => {\n                    event.preventDefault()\n                    event.dataTransfer.dropEffect = 'move'\n                  }}\n                  onDrop={event => {\n                    event.preventDefault()\n                    if (dragged.current)\n                      void send({\n                        type: 'tabSpace',\n                        tab: dragged.current,\n                        target: space.id\n                      })\n                    dragged.current = undefined\n                  }}\n                  onContextMenu={event => {\n                    event.preventDefault()\n                    setMenu('space:' + space.id)\n                  }}\n                  onClick={() => {\n                    choose('Tabs')\n                    void send({ type: 'spaceSwitch', target: space.id })\n                  }}>\n                  <span>{index + 1}</span>\n                  {space.name}\n                </button>\n              ))}\n              <Tool\n                icon=\"plus\"\n                label=\"Create Space\"\n                disabled={!inPrivate}\n                action={() => openEditor({ type: 'spaceCreate', name: '' })}\n              />\n            </div>\n            <div className=\"space-heading\">\n              <strong>{currentSpace?.name || 'Your workspace'}</strong>\n              <Tool\n                icon=\"menu\"\n                label=\"Space actions\"\n                disabled={!inPrivate}\n                action={() => setMenu('space:' + browser.activeSpace)}\n              />\n            </div>\n            <Button\n              variant=\"ghost\"\n              className=\"new-tab-action\"\n              isDisabled={!connected}\n              onPress={() => (inPrivate ? openPalette() : void createTab())}>\n              <Icon name=\"plus\" size={17} />\n              {inPrivate ? 'New tab' : 'Start private session'}\n              <kbd>⌘T</kbd>\n            </Button>\n            {inPrivate && (\n              <Input\n                className=\"tab-filter\"\n                aria-label=\"Filter tabs\"\n                value={tabFilter}\n                placeholder=\"Filter tabs\"\n                onChange={event => setTabFilter(event.target.value)}\n              />\n            )}\n            <div\n              className=\"vertical-tabs\"\n              role=\"tablist\"\n              aria-label=\"Browser tabs\"\n              aria-orientation=\"vertical\">\n              {spaceTabs.some(tab => tab.pinned) && (\n                <>\n                  <div className=\"sidebar-label\">Pinned</div>\n                  {spaceTabs.filter(tab => tab.pinned).map(verticalTab)}\n                </>\n              )}\n              {spaceGroups.map(group => (\n                <div className=\"tab-group\" key={group.id}>\n                  <div\n                    className=\"group-heading\"\n                    onDragOver={event => {\n                      event.preventDefault()\n                      event.dataTransfer.dropEffect = 'move'\n                    }}\n                    onDrop={event => {\n                      event.preventDefault()\n                      if (dragged.current)\n                        void send({\n                          type: 'tabGroup',\n                          tab: dragged.current,\n                          target: group.id\n                        })\n                      dragged.current = undefined\n                    }}\n                    onContextMenu={event => {\n                      event.preventDefault()\n                      setMenu('group:' + group.id)\n                    }}>\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      aria-expanded={!group.collapsed}\n                      onPress={() =>\n                        void send({ type: 'groupToggle', target: group.id })\n                      }>\n                      <Icon\n                        name={group.collapsed ? 'forward' : 'down'}\n                        size={14}\n                      />\n                      {group.name}\n                      <span>\n                        {\n                          spaceTabs.filter(\n                            tab => tab.group === group.id && !tab.pinned\n                          ).length\n                        }\n                      </span>\n                    </Button>\n                    <Tool\n                      icon=\"menu\"\n                      label={'Actions for group ' + group.name}\n                      action={() => setMenu('group:' + group.id)}\n                    />\n                  </div>\n                  {!group.collapsed &&\n                    spaceTabs\n                      .filter(tab => !tab.pinned && tab.group === group.id)\n                      .map(verticalTab)}\n                </div>\n              ))}\n              <div className=\"sidebar-label\">Today</div>\n              {spaceTabs\n                .filter(tab => !tab.pinned && !tab.group)\n                .map(verticalTab)}\n              {inPrivate && !spaceTabs.length && (\n                <p className=\"side-empty\">\n                  A clear space. Open a tab to begin.\n                </p>\n              )}\n            </div>\n            {spaceTabs.length > 1 && (\n              <div\n                className=\"sidebar-split-target\"\n                onDragOver={event => {\n                  event.preventDefault()\n                  event.dataTransfer.dropEffect = 'move'\n                }}\n                onDrop={event => {\n                  event.preventDefault()\n                  if (dragged.current && dragged.current !== active?.id)\n                    void send({ type: 'split', tab: dragged.current })\n                  dragged.current = undefined\n                }}>\n                <Icon name=\"split\" size={14} /> Drop a tab to split\n              </div>\n            )}\n            <div className=\"library-links\">\n              {sections.slice(1).map(item => (\n                <Button\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  key={item}\n                  aria-current={section === item ? 'page' : undefined}\n                  onPress={() => choose(item)}>\n                  <Icon name={item.toLowerCase()} size={15} />\n                  {item}\n                </Button>\n              ))}\n            </div>\n            <div className=\"side-footer\">\n              <span>\n                <Icon name={inPrivate ? 'shield' : 'profiles'} size={15} />\n                {inPrivate ? 'Private session' : 'No active profile'}\n              </span>\n              {inPrivate && (\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  onPress={() => {\n                    void send({ type: 'endPrivate' })\n                    choose('Tabs')\n                  }}>\n                  End session\n                </Button>\n              )}\n            </div>\n            <div\n              role=\"separator\"\n              aria-label=\"Resize sidebar\"\n              aria-orientation=\"vertical\"\n              aria-valuemin={166}\n              aria-valuemax={300}\n              aria-valuenow={sideWidth}\n              tabIndex={0}\n              className=\"resizer\"\n              onKeyDown={event => {\n                if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {\n                  event.preventDefault()\n                  setSideWidth(width =>\n                    Math.max(\n                      166,\n                      Math.min(\n                        300,\n                        width + (event.key === 'ArrowLeft' ? -12 : 12)\n                      )\n                    )\n                  )\n                }\n              }}\n              onPointerDown={event =>\n                event.currentTarget.setPointerCapture(event.pointerId)\n              }\n              onPointerMove={event => {\n                if (event.currentTarget.hasPointerCapture(event.pointerId))\n                  setSideWidth(Math.max(166, Math.min(300, event.clientX)))\n              }}\n            />\n          </aside>\n        )}\n        <div className=\"page-column\">\n          {splitTabs.length === 2 && (\n            <div className=\"splitbar\" aria-label=\"Split Screen panes\">\n              {splitTabs.map(tab => (\n                <div key={tab.id}>\n                  <Button\n                    size=\"sm\"\n                    variant=\"ghost\"\n                    aria-pressed={tab.id === active?.id}\n                    onPress={() => selectTab(tab)}>\n                    {tab.title}\n                  </Button>\n                  <Tool\n                    icon=\"close\"\n                    label={'Close pane ' + tab.title}\n                    action={() => tabAction('close', tab)}\n                  />\n                </div>\n              ))}\n              <Button\n                size=\"sm\"\n                variant=\"ghost\"\n                onPress={() => void send({ type: 'unsplit' })}>\n                {browser.splitCompact\n                  ? 'Narrow view · exit split'\n                  : 'Exit split'}\n              </Button>\n            </div>\n          )}\n          <main\n            className=\"content\"\n            ref={content}\n            aria-label=\"Browser workspace\">\n            {section === 'Tabs' &&\n              !isWeb &&\n              !active?.url &&\n              !active?.failure && (\n                <section className=\"welcome\">\n                  <div className=\"welcome-inner\">\n                    <span className=\"eyebrow\">\n                      <Icon name={inPrivate ? 'shield' : 'logo'} size={17} />\n                      {inPrivate ? 'Private browsing' : 'Vezham browser'}\n                    </span>\n                    <h1>{inPrivate ? 'Where to?' : 'Your next idea.'}</h1>\n                    <p>\n                      {inPrivate\n                        ? 